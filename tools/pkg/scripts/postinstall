#!/bin/sh
# Opens HomePad for the person at the keyboard (this script runs as root) once Installer has quit, so its Setup Guide
# is the next thing they see. Not straight away: with HomePad's welcome window open in front of Installer's last page,
# Installer couldn't move the disk image to the Trash. Waiting happens in the background, so the install itself
# finishes right away. Installs from the command line (`installer`, lowercase) don't match, so HomePad opens at once.
uid=$(/usr/bin/stat -f%u /dev/console)
if [ -n "$uid" ] && [ "$uid" -gt 0 ] 2>/dev/null; then
    (
        n=0
        # Every 2 seconds, for at most 6 hours.
        while /usr/bin/pgrep -x Installer >/dev/null 2>&1 && [ $n -lt 10800 ]; do
            /bin/sleep 2
            n=$((n + 1))
        done
        /bin/launchctl asuser "$uid" /usr/bin/open /Applications/HomePad.app
    ) </dev/null >/dev/null 2>&1 &
fi
exit 0
