<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>HomePad</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <readme file="readme.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <!-- Only "this Mac": no choosing a disk or a folder, it goes to Applications. -->
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="local.mike.HomePad"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="local.mike.HomePad" visible="false">
        <pkg-ref id="local.mike.HomePad"/>
    </choice>
    <pkg-ref id="local.mike.HomePad" version="1.1" onConclusion="none">HomePad-component.pkg</pkg-ref>
</installer-gui-script>
